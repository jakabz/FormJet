{
  "schemaVersion": 1,
  "listId": "00000000-0000-0000-0000-000000000000",
  "contentTypeId": "0x0100000000000000000000000000000000",
  "title": "Beszerzési igény",
  "labelPosition": "top",
  "style": {
    "base": { "accentColor": "#0f6cbd", "sectionHeader": "underline" },
    "new": { "accentColor": "#107c10" },
    "display": { "background": "#faf9f8", "density": "compact", "sectionHeader": "bar" }
  },
  "sections": [
    {
      "id": "basics",
      "title": "Alapadatok",
      "columns": 2,
      "fields": [
        { "field": "Title", "colSpan": 2 },
        { "field": "Category" },
        { "field": "Amount" },
        { "field": "NeededBy" },
        { "field": "Urgent" },
        { "field": "Justification", "colSpan": 2 }
      ]
    },
    {
      "id": "approval",
      "title": "Jóváhagyás",
      "description": "A jóváhagyó tölti ki.",
      "columns": 2,
      "collapsible": true,
      "visibleIn": ["edit", "display"],
      "style": {
        "base": {
          "backgroundGradient": { "type": "linear", "angle": 135, "colors": ["#fff9f5", "#ffe8dc"] },
          "borderColor": "#f4bfab",
          "borderWidth": 2,
          "borderRadius": 8,
          "headerColor": "#c43501"
        }
      },
      "fields": [
        { "field": "Approver" },
        { "field": "ApprovalStatus" },
        { "field": "ApprovalComment", "colSpan": 2 }
      ]
    },
    {
      "id": "invoices",
      "title": "Kapcsolódó számlák",
      "columns": 1,
      "collapsible": true,
      "related": {
        "listId": "11111111-1111-1111-1111-111111111111",
        "matchField": "RequestNumber",
        "sourceField": "Title",
        "columns": ["Title", "InvoiceDate", "Amount"],
        "sortField": "InvoiceDate",
        "sortAscending": false,
        "rowLimit": 20,
        "showNewButton": true
      },
      "fields": []
    }
  ],
  "fields": {
    "Title": {
      "label": "Megnevezés",
      "placeholder": "Mit szeretnél beszerezni?"
    },
    "Category": {
      "label": "Kategória",
      "defaultValue": "Irodaszer"
    },
    "Amount": {
      "label": "Összeg (Ft)",
      "requiredIn": ["new", "edit"]
    },
    "NeededBy": {
      "label": "Szükséges időpont"
    },
    "Urgent": {
      "label": "Sürgős",
      "defaultValue": "0"
    },
    "Justification": {
      "label": "Indoklás",
      "description": "500 000 Ft feletti összegnél kötelező.",
      "visibleWhen": { "field": "Amount", "op": "gt", "value": 500000 },
      "requiredWhen": { "field": "Amount", "op": "gt", "value": 500000 },
      "style": {
        "edit": { "background": "#fff4ce", "borderColor": "#f2c661", "borderRadius": 6, "labelColor": "#835b00" }
      }
    },
    "Approver": {
      "label": "Jóváhagyó",
      "readOnlyIn": ["edit"]
    },
    "ApprovalStatus": {
      "label": "Állapot"
    },
    "ApprovalComment": {
      "label": "Megjegyzés",
      "visibleWhen": {
        "any": [
          { "field": "ApprovalStatus", "op": "in", "value": ["Elutasítva", "Visszaküldve"] },
          { "field": "ApprovalComment", "op": "notEmpty" }
        ]
      }
    }
  }
}
