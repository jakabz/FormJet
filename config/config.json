{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "form-jet-form-customizer": {
      "components": [
        {
          "entrypoint": "./lib/extensions/formJet/FormJetFormCustomizer.js",
          "manifest": "./src/extensions/formJet/FormJetFormCustomizer.manifest.json"
        }
      ]
    },
    "form-jet-setup-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/formJetSetup/FormJetSetupWebPart.js",
          "manifest": "./src/webparts/formJetSetup/FormJetSetupWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "FormJetFormCustomizerStrings": "lib/extensions/formJet/loc/{locale}.js"
  }
}
